# Supabase 프로젝트 설정 > API 메뉴에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Settings > API > service_role 키 (절대 브라우저/클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 생략 시 기본값 claude-sonnet-5 사용
ANTHROPIC_MODEL=claude-sonnet-5

# 관리자 업로드 페이지(/admin) 접근용 PIN (원하는 숫자/문자열로 설정)
ADMIN_PIN=1234
# 관리자 세션 쿠키 서명에 사용하는 임의의 긴 무작위 문자열 (예: openssl rand -hex 32)
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string
